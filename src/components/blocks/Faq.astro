---
/** FAQ — stacked | split. Native <details>, no JS. Emits FAQPage JSON-LD. */
import type { BlockOf } from "../../schema/site-schema";
import Section from "../ui/Section.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import Markdown from "../ui/Markdown.astro";
import Icon from "../ui/Icon.astro";
import { sectionHeadingId } from "../../lib/heading";
import { md } from "../../lib/markdown";

interface Props {
  block: BlockOf<"faq">;
  index: number;
}
const { block, index } = Astro.props;
const hid = sectionHeadingId(block, index);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: block.items.map((i) => ({
    "@type": "Question",
    name: i.q,
    acceptedAnswer: { "@type": "Answer", text: md(i.a) },
  })),
};
const split = block.variant === "split";
---
<Section block={block} index={index}>
  <div class:list={["grid gap-x-[var(--space-gap)]", split ? "gap-y-10 lg:grid-cols-12" : "gap-y-0"]}>
    <div class:list={[split && "lg:col-span-5 lg:sticky lg:top-28 lg:self-start"]}>
      <SectionHeader eyebrow={block.eyebrow} heading={block.heading} intro={block.intro} headingId={hid} />
    </div>
    <div class:list={[split ? "lg:col-span-7" : "max-w-3xl", !split && (block.heading || block.intro) && "mt-gap"]}>
      {block.items.map((item) => (
        <details class="faq group border-b border-border first:border-t">
          <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-5 text-left t-h4 leading-snug [&::-webkit-details-marker]:hidden">
            <span>{item.q}</span>
            <Icon name="plus" class="mt-0.5 size-5 shrink-0 transition-transform duration-200 group-open:rotate-45" />
          </summary>
          <Markdown text={item.a} class="t-muted max-w-2xl pb-6" />
        </details>
      ))}
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</Section>
