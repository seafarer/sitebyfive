---
/**
 * Feature rows — alternating image/text rows. `startSide` is the first row's image side.
 * No-image fallback (per row): a two-column intro, label + title left, body right.
 */
import type { BlockOf } from "../../schema/site-schema";
import Section from "../ui/Section.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import Markdown from "../ui/Markdown.astro";
import Button from "../ui/Button.astro";
import Img from "../ui/Img.astro";
import { sectionHeadingId } from "../../lib/heading";

interface Props {
  block: BlockOf<"featureRows">;
  index: number;
}
const { block, index } = Astro.props;
const hasHeader = block.heading || block.intro || block.eyebrow;
---
<Section block={block} index={index}>
  <SectionHeader eyebrow={block.eyebrow} heading={block.heading} intro={block.intro} headingId={sectionHeadingId(block, index)} />
  <div class:list={["flex flex-col", hasHeader && "mt-gap"]}>
    {block.items.map((item, i) => {
      const imageLeft = (i % 2 === 0) === (block.startSide === "left");
      return item.image ? (
        <article class="grid items-center gap-x-[var(--space-gap)] gap-y-8 py-[calc(var(--space-gap)*0.6)] lg:grid-cols-2">
          <div class:list={["media media-lg aspect-[4/3]", !imageLeft && "lg:order-2"]}>
            <Img image={item.image} sizes="(min-width: 64rem) 50vw, 100vw" />
          </div>
          <div class="flex flex-col gap-4 lg:max-w-xl">
            {item.label && <p class="t-small font-semibold text-label">{item.label}</p>}
            <h3 class="t-h2 !text-[clamp(1.6rem,1.2rem+1.4vw,2.35rem)]">{item.title}</h3>
            <Markdown text={item.body} class="t-muted text-[1.0625rem]" />
            {item.link && <div class="pt-2"><Button cta={item.link} /></div>}
          </div>
        </article>
      ) : (
        <article class="grid gap-x-[var(--space-gap)] gap-y-4 border-t border-border py-10 first:border-t-0 first:pt-0 lg:grid-cols-12">
          <div class="flex flex-col gap-3 lg:col-span-5">
            {item.label && <p class="t-small font-semibold text-label">{item.label}</p>}
            <h3 class="t-h3 !text-[clamp(1.35rem,1.15rem+0.8vw,1.85rem)]">{item.title}</h3>
          </div>
          <div class="flex flex-col gap-4 lg:col-span-7">
            <Markdown text={item.body} class="t-muted text-[1.0625rem]" />
            {item.link && <div><Button cta={item.link} /></div>}
          </div>
        </article>
      );
    })}
  </div>
</Section>
