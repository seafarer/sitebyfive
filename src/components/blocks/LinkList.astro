---
/** Link list — grid (link cards) | split (header left, stacked links right). Never uses images. */
import type { BlockOf } from "../../schema/site-schema";
import Section from "../ui/Section.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import { sectionHeadingId } from "../../lib/heading";
import { isExternal, linkAttrs } from "../../lib/links";
import { gridCols } from "../../lib/grid";
import { t } from "../../lib/strings";

interface Props {
  block: BlockOf<"linkList">;
  index: number;
}
const { block, index } = Astro.props;
const hid = sectionHeadingId(block, index);
const hasHeader = block.heading || block.intro || block.eyebrow;
const arrow = (href: string, ext?: boolean) => (isExternal(href, ext) ? "↗" : "→");
---
<Section block={block} index={index}>
  {block.variant === "split" ? (
    <div class="grid gap-x-[var(--space-gap)] gap-y-10 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <SectionHeader eyebrow={block.eyebrow} heading={block.heading} intro={block.intro} headingId={hid} />
      </div>
      <ul class="flex flex-col lg:col-span-7" role="list">
        {block.items.map((item) => (
          <li class="border-b border-border first:border-t">
            <a {...linkAttrs(item)} class="group flex items-start justify-between gap-6 py-5">
              <span class="flex flex-col gap-1">
                <span class="t-h4 leading-snug group-hover:underline">{item.label}</span>
                {item.description && <span class="t-small t-muted">{item.description}</span>}
              </span>
              <span aria-hidden="true" class="btn-arrow mt-0.5 text-xl text-link">{arrow(item.href, item.external)}</span>
              {isExternal(item.href, item.external) && <span class="sr-only">{t.opensNewTab}</span>}
            </a>
          </li>
        ))}
      </ul>
    </div>
  ) : (
    <Fragment>
      <SectionHeader eyebrow={block.eyebrow} heading={block.heading} intro={block.intro} headingId={hid} />
      <ul class:list={["grid gap-4", gridCols[Math.min(block.columns, block.items.length)], hasHeader && "mt-gap"]} role="list">
        {block.items.map((item) => (
          <li class="flex">
            <a {...linkAttrs(item)} class="card group flex w-full flex-col gap-2 p-6 transition-transform hover:-translate-y-0.5">
              <span class="flex items-start justify-between gap-4">
                <span class="t-h4 leading-snug group-hover:underline">{item.label}</span>
                <span aria-hidden="true" class="text-xl text-link">{arrow(item.href, item.external)}</span>
              </span>
              {item.description && <span class="t-small t-muted">{item.description}</span>}
              {isExternal(item.href, item.external) && <span class="sr-only">{t.opensNewTab}</span>}
            </a>
          </li>
        ))}
      </ul>
    </Fragment>
  )}
</Section>
