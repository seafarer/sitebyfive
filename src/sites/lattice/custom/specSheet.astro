---
/**
 * specSheet — Lattice's one-off: a technical spec table in grouped columns.
 * Lives here, not in the block library, because only a hardware company needs it.
 * Uses theme tokens like any block; props are validated by specSheet.schema.ts.
 */
import type { SpecSheetProps } from "./specSheet.schema";

type Props = SpecSheetProps;
const { groups, footnote, download } = Astro.props;
---
<div class="grid gap-x-[var(--space-gap)] gap-y-10 md:grid-cols-2 lg:grid-cols-3">
  {groups.map((g) => (
    <div>
      <h3 class="eyebrow mb-4">{g.title}</h3>
      <dl class="flex flex-col">
        {g.rows.map((r) => (
          <div class="flex items-baseline justify-between gap-6 border-b border-border py-3 first:border-t">
            <dt class="t-muted t-small">{r.label}</dt>
            <dd class="text-right font-heading font-semibold tabular-nums">{r.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  ))}
</div>
{(footnote || download) && (
  <div class="mt-10 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    {footnote && <p class="t-small t-muted max-w-2xl">{footnote}</p>}
    {download && <a href={download.href} class="btn btn-secondary shrink-0">{download.label} <span aria-hidden="true">↓</span></a>}
  </div>
)}
